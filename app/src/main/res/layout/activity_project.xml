<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:titleTextColor="#FFFFFF"
            app:subtitleTextColor="#DDFFFFFF" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/throttleWarn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/warn"
                android:padding="12dp"
                android:text="@string/status_throttled"
                android:textColor="#FFFFFF"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wizardBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:text="@string/wizard_open" />

            <TextView style="@style/SectionHeader" android:text="@string/floors" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/floorsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:id="@+id/floorsEmpty"
                style="@style/EmptyText"
                android:text="@string/floors_empty" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addFloor"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/add_floor" />

            <TextView style="@style/SectionHeader" android:text="@string/surveys" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/surveysList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:id="@+id/surveysEmpty"
                style="@style/EmptyText"
                android:text="@string/surveys_empty" />

            <TextView style="@style/SectionHeader" android:text="@string/networks" />
            <Spinner
                android:id="@+id/floorFilter"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp" />
            <TextView
                android:id="@+id/netSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:textColor="@color/text"
                android:textSize="14sp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/ssidList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView style="@style/SectionHeader" android:text="@string/access_points" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
            <TextView
                android:id="@+id/apsEmpty"
                style="@style/EmptyText"
                android:text="@string/aps_empty" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/syncAps"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_aps" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteAps"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/delete_aps"
                    android:textColor="@color/warn" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
