<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <EditText android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/project_name_hint" android:inputType="textCapSentences" />
    <EditText android:id="@+id/customer" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/customer_hint" android:inputType="textCapWords" />
    <EditText android:id="@+id/location" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/location_hint" android:inputType="textCapWords" />
    <EditText android:id="@+id/surveyor" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/surveyor_hint" android:inputType="textCapWords" />
</LinearLayout>
