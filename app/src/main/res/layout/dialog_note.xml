<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <EditText android:id="@+id/text" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/note_text_hint" android:inputType="textMultiLine|textCapSentences" android:minLines="2" android:maxLines="6" />
    <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="200dp" android:layout_marginTop="12dp" android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@string/note_photo" />
    <com.google.android.material.button.MaterialButton android:id="@+id/photoBtn" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/note_photo" />
</LinearLayout>
